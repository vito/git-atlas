"""
Keep the git atlas in sync with dagger/dagger.

dagger generate refreshes everything derived (PR metadata, API signatures and
docs, QUEUE.md, index.html); dagger check verifies the hand-written data
against the upstream code and makes sure nothing derived is stale.
"""
type GitAtlas {
  let githubToken: Secret

  new(
    """
    GitHub token, used only by generate to read unmerged PRs (state, title,
    head). Optional: without it, unmerged PRs keep their previous metadata
    and take their heads from git ls-remote.
    """
    githubToken: Secret = null,
  ) {
    self.githubToken = githubToken
    self
  }

  """
  Expertise for maintaining the atlas: the procedure, the grounding rules,
  and tools to read upstream PRs and find symbols at a commit.
  """
  agent(base: LLM!): LLM! @agent {
    base
      .withTools(currentNode, except: ["generate", "validate", "fresh", "coverage", "unit", "smoke"])
      .withSystemPrompt(systemPrompt)
  }

  let systemPrompt = """
    This workspace is the git atlas: hand-written YAML under data/ describing how each
    public git-related field of the Dagger API is implemented in dagger/dagger, one tab
    (data/revisions/<family>/<pr>.yaml) per PR that changed it. index.html, QUEUE.md and
    derived/ are generated; never edit them by hand.

    Before adding or changing anything under data/, read the process-pr skill
    (ReadSkill "process-pr") and follow it. The essentials:
    - Describe the code at the commit a tab is about: a merged PR's merge commit, or an
      open PR's head (pin it with sha:). Never describe main, or your memory of it.
    - Read upstream with trackedDiff (a PR's diff, limited to the tracked paths), then
      committer_fileAt / committer_show with from: "https://github.com/dagger/dagger#<sha>"
      for whole files. gh needs --repo dagger/dagger for upstream PRs.
    - Write source: code only for code you actually read at that commit; otherwise
      source: pr-description. Leave verified_at: null unless you re-verified an
      existing tab against the code.
    - Before writing a pointer (path:symbol), look the symbol up with findSymbol at the
      tab's commit and copy its path:symbol.
    - Finish with the git-atlas generator (dagger generate) and then the git-atlas
      checks; fix every validate failure before committing.
    """

  """
  Show what a dagger/dagger PR changed under the atlas's tracked paths
  (atlas.yaml): a merged PR's merge commit against its first parent, or an
  unmerged PR's current head against its merge base with main. The header
  names the commit to read files at and, for unmerged PRs, the sha: to pin.
  """
  trackedDiff(
    ws: Workspace!,
    """PR number in dagger/dagger."""
    pr: Int!,
    """Globs replacing the tracked paths, e.g. ["core/git_local*.go"]."""
    paths: [String!]! = [],
    """Only the diffstat: which tracked files changed, and how much."""
    stat: Boolean! = false,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    let args = ["atlas", "tracked-diff", "-upstream", "/cache/upstream.git", "-paths", paths.join(",")]
    if (stat) { args += ["-stat"] }
    runner(source(ws))
      .withEnvVariable("ATLAS_NONCE", UUID.v7)
      .withExec(args + [toString(pr)])
      .stdout
  }

  """
  Find where a Go symbol is defined in dagger/dagger at a commit, printed as
  pointers ready for data/ (path:Symbol@sha). name is a function, a method
  as Type.method (a bare method name lists every receiver), or a
  type/var/const. Tests are excluded.
  """
  findSymbol(
    ws: Workspace!,
    """Symbol to look for, e.g. refJoin, LocalGitRef.Tree or GitCheckoutBase."""
    name: String!,
    """Commit to search: a full or short SHA, or a branch such as main."""
    commit: String!,
    """Globs replacing the default scope (core, engine, dagql, util, cmd)."""
    paths: [String!]! = [],
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    runner(source(ws))
      .withEnvVariable("ATLAS_NONCE", UUID.v7)
      .withExec(["atlas", "find-symbol", "-upstream", "/cache/upstream.git", "-paths", paths.join(","), name, commit])
      .stdout
  }

  """
  Refresh derived data from the upstream branch tip and GitHub, assign
  colors to new PRs, and rebuild QUEUE.md and index.html.
  """
  generate(ws: Workspace!): Changeset! @generate @cache(policy: FunctionCachePolicy.Never) {
    let src = source(ws)
    let ctr = runner(src).withEnvVariable("ATLAS_REFRESH_NONCE", UUID.v7)
    let tok = githubToken
    if (tok != null) {
      ctr = ctr.withSecretVariable("GITHUB_TOKEN", tok)
    }
    ctr
      .withExec(["atlas", "generate", "-refresh", "-upstream", "/cache/upstream.git"])
      .directory("/src")
      .changes(src)
  }

  """
  Validate the data: schema (required fields, enums, unique colors), cross
  references (PRs, APIs, families, mechanisms), API names against the GraphQL
  schema, and every code pointer against the file at its commit.
  """
  validate(ws: Workspace!): Void @check {
    atlasCheck(ws, "validate")
  }

  """
  Fail when generating at the pinned upstream commit would change anything:
  index.html, QUEUE.md, derived/ and PR colors must be committed up to date.
  """
  fresh(ws: Workspace!): Void @check {
    atlasCheck(ws, "fresh")
  }

  """
  Fail while QUEUE.md has blocking entries: merged PRs that touch tracked
  paths but are neither described nor skipped, and tabs written against a
  head that has since merged.
  """
  coverage(ws: Workspace!): Void @check {
    atlasCheck(ws, "coverage")
  }

  """
  Exercise the agent tools against known upstream commits: trackedDiff on a
  merged PR, findSymbol for a method that lives outside the file its name
  suggests.
  """
  agentTools(ws: Workspace!): Void @check {
    let diff = trackedDiff(ws, pr: 14395, stat: true)
    if (!diff.contains("merged 2026-09-30 as a96196e") or !diff.contains("core/git_local.go")) {
      raise "trackedDiff 14395: unexpected output:\n" + diff
    }
    let found = findSymbol(ws, name: "withRemote", commit: "40a74d06ffe6b18d6cac020a1e3a7b007ebb7f19")
    if (!found.contains("core/schema/git_push.go:gitSchema.withRemote@40a74d0")) {
      raise "findSymbol withRemote: unexpected output:\n" + found
    }
    null
  }

  """
  Unit tests of the atlas tool (globs, pointer parsing, symbol lookup).
  """
  unit(ws: Workspace!): Void @check {
    container.from("golang:1.24-alpine")
      .withMountedCache("/go/pkg/mod", cacheVolume("git-atlas-go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("git-atlas-go-build"))
      .withEnvVariable("CGO_ENABLED", "0")
      .withWorkdir("/build")
      .withDirectory("/build", source(ws), include: ["go.mod", "go.sum", "cmd/**"])
      .withExec(["go", "test", "./cmd/..."])
      .sync
    null
  }

  """
  Load index.html in headless Chromium, directly and the way gistpreview
  injects it, and drive the PR highlight dropdown.
  """
  smoke(ws: Workspace!): Void @check {
    let src = source(ws)
    container.from("alpine:3.22")
      .withExec(["apk", "add", "--no-cache", "chromium", "python3"])
      .withDirectory("/w", src.directory("smoke"))
      .withFile("/w/index.html", src.file("index.html"))
      .withExec(["sh", "/w/run.sh"])
      .sync
    null
  }

  let atlasCheck(ws: Workspace!, name: String!): Void {
    runner(source(ws))
      .withExec(["atlas", "check", name, "-upstream", "/cache/upstream.git"])
      .sync
    null
  }

  let source(ws: Workspace!): Directory! {
    ws.directory("/", exclude: [".git", ".dagger", "tmp"])
  }

  let runner(src: Directory!): Container! {
    let bin = container.from("golang:1.24-alpine")
      .withMountedCache("/go/pkg/mod", cacheVolume("git-atlas-go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("git-atlas-go-build"))
      .withEnvVariable("CGO_ENABLED", "0")
      .withWorkdir("/build")
      .withDirectory("/build", src, include: ["go.mod", "go.sum", "cmd/**"])
      .withExec(["go", "build", "-o", "/out/atlas", "./cmd/atlas"])
      .file("/out/atlas")
    container.from("alpine:3.22")
      .withExec(["apk", "add", "--no-cache", "git", "ca-certificates"])
      .withFile("/usr/local/bin/atlas", bin)
      .withMountedCache("/cache", cacheVolume("git-atlas-upstream"), sharing: CacheSharingMode.LOCKED)
      .withDirectory("/src", src)
      .withWorkdir("/src")
  }
}
